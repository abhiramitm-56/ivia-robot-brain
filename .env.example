# ==========================================
# IVIA Humanoid Companion - Environment Config
# ==========================================

# Choose AI Provider: "groq" (Recommended: ultra-low latency < 300ms) or "openai"
AI_PROVIDER=groq

# Optional: Add your Groq API Key (https://console.groq.com)
GROQ_API_KEY=

# Optional: Add your OpenAI API Key (https://platform.openai.com)
OPENAI_API_KEY=

# Optional: Add your Gemini API Key (https://aistudio.google.com)
GEMINI_API_KEY=

# Network Settings
HOST=0.0.0.0
PORT=8000

# Microsoft Neural Voice for IVIA (Free, Natural Human Tone)
# Options: "en-US-AriaNeural" (female), "en-US-JennyNeural", "en-US-GuyNeural" (male)
TTS_VOICE=en-US-AriaNeural

# Voice Activity Detection (VAD) Sensitivity
SILENCE_THRESHOLD=800
SILENCE_DURATION_SEC=1.2
MIN_SPEECH_DURATION_SEC=0.5
