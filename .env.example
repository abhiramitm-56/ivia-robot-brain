# ==========================================
# IVIA Humanoid Companion - Environment Config
# Keep this file on your Raspberry Pi only! Never commit your real .env to GitHub.
# ==========================================

# Choose AI Provider: "groq" (Recommended: ultra-low latency < 300ms) or "openai"
AI_PROVIDER=groq

# Groq API Key (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Groq LLM Model (Default: qwen/qwen3.8-27b or llama-3.3-70b-versatile)
GROQ_MODEL=qwen/qwen3.8-27b

# Optional: OpenAI API Key (if AI_PROVIDER=openai)
OPENAI_API_KEY=

# Optional: Gemini API Key
GEMINI_API_KEY=

# Network Settings
HOST=0.0.0.0
PORT=8000

# Set to false for lightweight voice-only mode on Raspberry Pi 4 (2GB RAM)
ENABLE_VISION=false

# Neural Voices (Edge-TTS)
# Malayalam: ml-IN-SobhanaNeural
# English: en-US-AriaNeural
# Hindi: hi-IN-SwaraNeural
TTS_VOICE=en-US-AriaNeural

# Voice Activity Detection (VAD) Sensitivity
SILENCE_THRESHOLD=450
SILENCE_DURATION_SEC=0.45
MIN_SPEECH_DURATION_SEC=0.3
